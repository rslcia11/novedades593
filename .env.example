# Copia este archivo como .env y ajusta los valores.
# Todas son públicas: se usan al construir el sitio y pueden verse en el HTML.

# URL final del sitio, sin barra al final. Se usa en canonical, sitemap, RSS y datos estructurados.
SITE_URL=https://entretenimiento593.pages.dev

# Subcarpeta donde vive el sitio. Vacío o / en un dominio propio o en Cloudflare Pages.
# En GitHub Pages de proyecto es /nombre-del-repo (el flujo de despliegue la pone solo).
BASE_PATH=

# true solo cuando el sitio esté listo para Google (contenido real, legales completos).
# Mientras sea false, todas las páginas llevan noindex y robots.txt bloquea el rastreo.
PUBLIC_SITE_INDEXABLE=false

# Proveedor de anuncios: none | placeholder | adsense
#   none        no muestra nada
#   placeholder recuadros grises para revisar la ubicación de los anuncios
#   adsense     anuncios reales (requiere PUBLIC_ADSENSE_CLIENT y los IDs de bloque en src/config/ads.ts)
PUBLIC_ADS_PROVIDER=placeholder

# ID de editor de AdSense, formato ca-pub-0000000000000000
PUBLIC_ADSENSE_CLIENT=
