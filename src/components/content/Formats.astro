---
/** Formatos comerciales. Uso: <Formats><Format title="Banners">detalle</Format></Formats> */
---

<div class="formats">
  <slot />
</div>

<style>
  .formats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 600px) {
    .formats {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
