---
/** Recuadro con título y lista ("Errores comunes", "Cuidado con las estafas"). */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="box">
  <b>{title}</b>
  <slot />
</aside>

<style>
  .box {
    border: 2px solid var(--color-text);
    border-radius: var(--radius-md);
    padding: 18px 22px;
  }

  b {
    display: block;
    font-size: 0.9375rem;
    margin-bottom: 6px;
  }

  .box :global(ul) {
    margin: 0;
    padding-left: 20px;
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .box :global(p) {
    margin: 0;
  }
</style>
