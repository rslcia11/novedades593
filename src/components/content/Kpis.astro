---
/** Cifras destacadas (página "Anuncia con nosotros"). Uso: <Kpis><Kpi value="18–34">edad</Kpi></Kpis> */
---

<dl class="kpis">
  <slot />
</dl>

<style>
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-inline: 0;
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
