---
/**
 * Etiquetas <head> de SEO: título, descripción, canonical, robots, Open Graph, Twitter y JSON-LD.
 * Mientras PUBLIC_SITE_INDEXABLE sea false, todo el sitio queda fuera de Google (noindex).
 */
import { PUBLIC_SITE_INDEXABLE } from 'astro:env/server';
import { SITE } from '@/config/site';
import { graph, serializeJsonLd, type JsonLd } from '@/lib/seo';

export interface SeoProps {
  title: string;
  description: string;
  /** Ruta propia de la página; por defecto, la actual. */
  path?: string;
  /** Ruta o URL de la imagen para redes (1200×630). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  article?: { publishedAt: Date; updatedAt?: Date | undefined; section: string };
  noindex?: boolean;
  schema?: JsonLd[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = '/og-default.png',
  imageAlt = `${SITE.name}: ${SITE.tagline}`,
  type = 'website',
  article,
  noindex = false,
  schema = [],
} = Astro.props as SeoProps;

if (!Astro.site) throw new Error('Falta `site` en astro.config.ts.');
const canonical = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const fullTitle = path === '/' ? `${SITE.name} · ${SITE.tagline}` : `${title} · ${SITE.name}`;
const indexable = PUBLIC_SITE_INDEXABLE && !noindex;
const robots = indexable
  ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
  : 'noindex, nofollow';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="es_EC" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{article && (
  <>
    <meta property="article:published_time" content={article.publishedAt.toISOString()} />
    <meta
      property="article:modified_time"
      content={(article.updatedAt ?? article.publishedAt).toISOString()}
    />
    <meta property="article:section" content={article.section} />
  </>
)}
<meta name="twitter:card" content="summary_large_image" />

{schema.length > 0 && (
  <script is:inline type="application/ld+json" set:html={serializeJsonLd(graph(schema))} />
)}
