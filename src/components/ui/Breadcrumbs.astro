---
/** Migas de pan visibles. Los datos estructurados equivalentes los emite la página con `breadcrumbSchema`. */
export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Migas de pan">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href && i < items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current={i === items.length - 1 ? 'page' : undefined}>{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: 14px;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 6px;
  }

  li + li::before {
    content: '/';
    margin-right: 6px;
  }

  a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  @media (pointer: coarse) {
    a {
      display: inline-block;
      padding-block: 8px;
    }
  }
</style>
