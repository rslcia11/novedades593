---
import { ICONS, isIconName } from './icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size, class: className } = Astro.props;
if (!isIconName(name)) throw new Error(`Ícono desconocido: ${name}`);
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>
