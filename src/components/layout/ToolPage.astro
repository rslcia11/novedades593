---
/** Estructura de una herramienta: encabezado, la herramienta, preguntas frecuentes y otras herramientas. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SECTIONS } from '@/config/sections';
import { getTool } from '@/config/tools';
import { breadcrumbSchema, schemaContext } from '@/lib/seo';
import { sectionUrl } from '@/lib/urls';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ToolsGrid from '@/components/tools/ToolsGrid.astro';
import Faq from '@/components/tools/Faq.astro';
import AdSlot from '@/components/ads/AdSlot.astro';

interface Props {
  tool: string;
  /** Título para Google (más descriptivo que el nombre corto). */
  seoTitle: string;
  faq: { question: string; answer: string }[];
}

const { tool: toolId, seoTitle, faq } = Astro.props;
const tool = getTool(toolId);
const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: SECTIONS.herramientas.name, href: sectionUrl('herramientas') },
  { label: tool.name },
];
---

<BaseLayout
  title={seoTitle}
  description={tool.description}
  schema={[breadcrumbSchema(crumbs, schemaContext(Astro.site))]}
>
  <div class="wrap">
    <header class="t-head">
      <Breadcrumbs items={crumbs} />
      <h1>{tool.name}</h1>
      <p class="dek">{tool.description}</p>
    </header>
    <div class="tool-wrap">
      <div data-pagefind-body data-pagefind-meta={`kicker:${SECTIONS.herramientas.name}`}>
        <span class="sr-only" data-pagefind-meta="title">
          {tool.name}
        </span>
        <slot />
        <Faq items={faq} />
      </div>
      <aside aria-label="Publicidad">
        <AdSlot placement="sidebar" />
      </aside>
    </div>
    <section class="sec" aria-labelledby="other-tools">
      <SectionHeader title="Otras herramientas" id="other-tools" />
      <ToolsGrid exclude={tool.id} limit={3} />
    </section>
  </div>
</BaseLayout>

<style>
  .t-head {
    padding-top: 32px;
    max-width: 820px;
    display: grid;
    gap: 16px;
  }

  h1 {
    font-size: clamp(30px, 4.6vw, 52px);
    font-weight: var(--weight-black);
    line-height: 1.05;
  }

  .dek {
    font-size: 1.1875rem;
    color: var(--color-text-2);
  }

  .tool-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    margin-top: 32px;
    align-items: start;
  }

  @media (max-width: 960px) {
    .tool-wrap {
      grid-template-columns: minmax(0, 1fr);
    }

    .tool-wrap > aside {
      display: none;
    }
  }
</style>
