---
/**
 * Página de un viral: el clip (con el reproductor oficial de la red) y siempre texto propio
 * que aporte contexto. Copiar y pegar un video sin texto sería "contenido replicado".
 */
import { render } from 'astro:content';
import { articleKicker, getArticles, getAuthor, type Article } from '@/lib/content';
import { inSection, pickRelated } from '@/lib/article-utils';
import { sectionUrl } from '@/lib/urls';
import { mdxComponents } from '@/components/content';
import Breadcrumbs, { type Crumb } from '@/components/ui/Breadcrumbs.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import Byline from './Byline.astro';
import ArticleList from './ArticleList.astro';
import ClipRail from './ClipRail.astro';

interface Props {
  article: Article;
  crumbs: Crumb[];
}

const { article, crumbs } = Astro.props;
const { Content } = await render(article);
const [author, all, kicker] = await Promise.all([
  getAuthor(article.data.author.id),
  getArticles(),
  articleKicker(article),
]);
const related = pickRelated(article, all);
const moreClips = inSection(all, 'virales').filter((a) => a.id !== article.id);
const { data } = article;
---

<div class="wrap">
  <header class="a-head">
    <Breadcrumbs items={crumbs} />
    <h1 data-pagefind-meta="title">{data.title}</h1>
    <p class="dek">{data.description}</p>
    <Byline article={article} author={author} />
  </header>

  <div class="viral">
    {data.video?.embedUrl ? (
      <iframe
        class="v"
        src={data.video.embedUrl}
        title={`Video: ${data.title}`}
        loading="lazy"
        allow="encrypted-media; picture-in-picture"
        allowfullscreen
      />
    ) : (
      <div class="v" role="img" aria-label={`Clip de ${data.video?.duration}`}>
        <Icon name="play" />
        <small>El clip se inserta con el reproductor oficial de la red · {data.video?.duration}</small>
      </div>
    )}
    <div>
      <article class="prose" data-pagefind-body data-pagefind-meta={`kicker:${kicker}`}>
        <Content components={mdxComponents} />
      </article>
      <section class="more" aria-labelledby="viral-related">
        <h2 id="viral-related">Si te gustó, esto te sirve</h2>
        <ArticleList articles={related} compact />
      </section>
    </div>
  </div>

  <section class="sec" aria-labelledby="more-clips">
    <SectionHeader
      title="Más virales"
      id="more-clips"
      more={{ label: 'Ver todos', href: sectionUrl('virales') }}
    />
    <ClipRail articles={moreClips} />
  </section>
</div>

<style>
  .a-head {
    padding-top: 32px;
    max-width: 820px;
    display: grid;
    gap: 16px;
  }

  h1 {
    font-size: clamp(30px, 4.6vw, 52px);
    font-weight: var(--weight-black);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .dek {
    font-size: 1.1875rem;
    color: var(--color-text-2);
  }

  .viral {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: 40px;
    margin-top: 28px;
    align-items: start;
  }

  .v {
    aspect-ratio: 9 / 16;
    width: 100%;
    border: 0;
    border-radius: 12px;
    background: var(--color-inverse-bg);
    color: var(--color-inverse-text);
    display: grid;
    place-items: center;
    position: relative;
  }

  .v :global(svg) {
    width: 72px;
    height: 72px;
  }

  .v small {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    font-size: 0.8125rem;
    color: var(--color-inverse-muted);
  }

  .more {
    margin-top: 28px;
  }

  .more h2 {
    font-size: 1.375rem;
    font-weight: var(--weight-heavy);
    margin-bottom: 16px;
  }

  @media (max-width: 1000px) {
    .viral {
      grid-template-columns: minmax(0, 1fr);
    }

    .v {
      max-height: 70vh;
      margin-inline: auto;
      max-width: 360px;
    }
  }
</style>
