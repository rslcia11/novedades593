---
/** Viral en formato vertical (9:14), como se ve en TikTok. */
import { articleHref, type Article } from '@/lib/content';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  article: Article;
  index?: number;
}

const { article, index = 0 } = Astro.props;
const tones = ['inverse', 'accent', 'soft'] as const;
const tone = tones[index % tones.length];
---

<a class="clip pressable" href={articleHref(article)} role="listitem">
  <div class:list={['v', `v--${tone}`]}>
    <Icon name="play" />
    <small>
      <span class="sr-only">Duración </span>
      {article.data.video?.duration}
    </small>
  </div>
  <h3>{article.data.title}</h3>
</a>

<style>
  .clip {
    scroll-snap-align: start;
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .v {
    aspect-ratio: 9 / 14;
    border-radius: var(--radius-md);
    position: relative;
    display: grid;
    place-items: center;
  }

  .v--inverse {
    background: var(--color-inverse-bg);
    color: var(--color-inverse-text);
  }

  .v--accent {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .v--soft {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .v :global(svg) {
    width: 44px;
    height: 44px;
  }

  small {
    position: absolute;
    left: 10px;
    bottom: 10px;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
  }

  h3 {
    font-size: 0.9375rem;
    font-weight: var(--weight-bold);
    line-height: 1.3;
  }
</style>
