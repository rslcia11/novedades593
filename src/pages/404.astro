---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchBox from '@/components/search/SearchBox.astro';
import GamesGrid from '@/components/home/GamesGrid.astro';
---

<BaseLayout
  title="No encontramos esa página"
  description="Puede que el enlace esté mal escrito o que la guía haya cambiado de lugar."
  noindex
>
  <div class="wrap">
    <header class="nf">
      <h1>No encontramos esa página</h1>
      <p class="dek">
        Puede que el enlace esté mal escrito o que la guía haya cambiado de lugar. Búscala o elige tu juego.
      </p>
      <SearchBox id="q-404" />
      <div>
        <a class="btn" href="/">
          Ir al inicio
        </a>
      </div>
    </header>
    <section class="sec" aria-label="Juegos">
      <GamesGrid />
    </section>
  </div>
</BaseLayout>

<style>
  .nf {
    padding-top: 32px;
    max-width: 820px;
    display: grid;
    gap: 16px;
  }

  h1 {
    font-size: clamp(30px, 4.6vw, 52px);
    font-weight: var(--weight-black);
    line-height: 1.05;
  }

  .dek {
    font-size: 1.1875rem;
    color: var(--color-text-2);
  }
</style>
